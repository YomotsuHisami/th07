diff --git a/src/audio/emscripten/SDL_emscriptenaudio.c b/src/audio/emscripten/SDL_emscriptenaudio.c
index 4087a5efc..fd1e72e1f 100644
--- a/src/audio/emscripten/SDL_emscriptenaudio.c
+++ b/src/audio/emscripten/SDL_emscriptenaudio.c
@@ -186 +186,6 @@ static bool EMSCRIPTENAUDIO_OpenDevice(SDL_AudioDevice *device)
-    device->sample_frames = SDL_GetDefaultSampleFramesFromFreq(device->spec.freq) * 2;  // double the buffer size, some browsers need more, and we'll just have to live with the latency.
+    // Keep the stock Emscripten backend architecture, but give its main-thread
+    // ScriptProcessor callback a larger scheduling window. At the common
+    // 44.1/48 kHz rates this selects a 4096-frame block (~93/~85 ms) instead
+    // of the stock doubled 2048-frame block. Higher native rates retain SDL's
+    // existing frequency-scaled minimum.
+    device->sample_frames = SDL_max(4096, SDL_GetDefaultSampleFramesFromFreq(device->spec.freq) * 2);
