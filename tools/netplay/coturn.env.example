# Shared by coturn and lan-relay.cjs. Keep the real file outside the repository.
TH07_TURN_REALM=turn.example.com
TH07_TURN_SHARED_SECRET=CHANGE_ME

# Signaling sends these URLs to browsers. Start with UDP + TCP on 3478.
TH07_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TH07_STUN_URLS=stun:stun.cloudflare.com:3478
TH07_TURN_TTL_SECONDS=3600

# Conservative defaults for the current ~10 Mbps VPS.
TH07_TURN_USER_QUOTA=12
TH07_TURN_TOTAL_QUOTA=256
TH07_TURN_MAX_BPS=131072
TH07_TURN_BPS_CAPACITY=786432

# TURN relay port range. Open UDP for this range in the host/cloud firewall.
TH07_TURN_MIN_PORT=49152
TH07_TURN_MAX_PORT=65535

# Usually unnecessary on a VPS with its public address directly assigned.
# TH07_TURN_EXTERNAL_IP=203.0.113.10
# TH07_TURN_LISTENING_IP=0.0.0.0
# TH07_TURN_RELAY_IP=0.0.0.0

# Optional TURN/TLS. When enabled, also add a turns: URL to TH07_TURN_URLS.
# TH07_TURN_CERT=/etc/letsencrypt/live/turn.example.com/fullchain.pem
# TH07_TURN_PKEY=/etc/letsencrypt/live/turn.example.com/privkey.pem
# TH07_TURN_TLS_LISTENING_PORT=5349
